{
  "name": "neuraos",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24.13 <25"
  },
  "scripts": {
    "dev": "node scripts/native/dev.mjs",
    "daemon": "tsx apps/daemon/src/main.ts",
    "build": "node scripts/native/build.mjs",
    "desktop:build": "node scripts/native/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/native/*.test.ts",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "service": "tsx scripts/native/service.ts",
    "postinstall": "node scripts/prepare-native.mjs",
    "legacy:dev": "tsx scripts/dev.ts",
    "legacy:runner": "tsx apps/runner/src/main.ts",
    "legacy:cloud": "tsx apps/cloud-api/src/main.ts",
    "legacy:desktop": "tauri dev --config apps/desktop/src-tauri/tauri.conf.json",
    "legacy:build": "vite build --config apps/desktop/vite.config.ts",
    "legacy:test": "tsx --test tests/*.test.ts",
    "legacy:test:ui": "playwright test",
    "legacy:check": "pnpm typecheck && pnpm test && pnpm build",
    "legacy:db:migrate": "tsx scripts/migrate.ts",
    "legacy:doctor": "tsx scripts/doctor.ts",
    "legacy:backup": "tsx scripts/backup.ts",
    "legacy:service": "tsx scripts/service.ts",
    "legacy:desktop:build": "cd apps/desktop && tauri build",
    "legacy:eval": "tsx scripts/evaluate.ts"
  },
  "dependencies": {
    "@ai-sdk/react": "4.0.150",
    "@anthropic-ai/claude-agent-sdk": "0.3.306",
    "@aws-sdk/client-s3": "3.1154.0",
    "@monaco-editor/react": "4.7.0",
    "@opentelemetry/api": "1.10.0",
    "@radix-ui/themes": "3.3.0",
    "@streamdown/cjk": "1.0.4",
    "@streamdown/code": "2.0.0",
    "@streamdown/math": "1.0.3",
    "@streamdown/mermaid": "1.0.3",
    "@tauri-apps/api": "2.12.4",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "ai": "7.0.146",
    "cron-parser": "5.10.2",
    "fastify": "5.12.7",
    "ignore": "7.0.13",
    "katex": "0.19.0",
    "lucide-react": "1.60.0",
    "monaco-editor": "0.57.0",
    "node-pty": "1.1.0",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "streamdown": "2.7.1",
    "use-stick-to-bottom": "1.1.6",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.12.3",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
