{
  "name": "neuraos",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24.13 <25"
  },
  "scripts": {
    "dev": "node scripts/native/dev.mjs",
    "daemon": "cargo run --release --locked --manifest-path crates/native-core/Cargo.toml --",
    "build": "node scripts/native/build.mjs",
    "desktop:build": "node scripts/native/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/native/*.test.ts",
    "test:macos": "node scripts/native/chromium/prepare.mjs && swift test --package-path apps/macos",
    "check": "pnpm typecheck && pnpm test && pnpm test:macos && pnpm build",
    "service": "node scripts/native/service.mjs",
    "postinstall": "node scripts/prepare-native.mjs",
    "daemon:legacy": "tsx apps/daemon/src/main.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.306",
    "fastify": "5.12.7",
    "node-pty": "1.1.0",
    "ws": "^8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
