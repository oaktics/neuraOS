# Secrets belong in Keychain (Runner) or hosting environment (Cloud API).
NEURA_DATA_DIR=.data
NEURA_RUNNER_PORT=4317
# NEURA_CLOUD_URL=https://neura-api.example.com
# NEURA_WORKSPACE_ID=<uuid>
# NEURA_GITHUB_CLIENT_ID=<OAuth-App-client-id-with-device-flow-enabled>
# Cloud server only: Neon or another PostgreSQL provider, non-bypass role.
# DATABASE_URL=postgres://neura_app:...@host/neuraos?sslmode=require
# NEURA_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# NEURA_STORAGE_BUCKET=neura-artifacts
# NEURA_S3_ACCESS_KEY_ID=<server-only>
# NEURA_S3_SECRET_ACCESS_KEY=<server-only>
# NEURA_ALLOWED_GITHUB_IDS=<numeric-GitHub-user-id>
# NEURA_CLOUD_PORT=4318
# NEURA_CLOUD_HOST=127.0.0.1
# NEURA_SCHEDULER_WORKSPACE=<uuid>
# NEURA_SCHEDULER_OWNER=github:<numeric-GitHub-user-id>
